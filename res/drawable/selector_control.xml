<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetTop="3.0dp" android:insetBottom="3.0dp">
            <shape android:shape="rectangle">
                <gradient android:startColor="@color/red" android:endColor="@color/red_500" android:angle="315.0" android:type="linear" />
                <corners android:radius="15.0dp" />
            </shape>
        </inset>
    </item>
    <item android:state_selected="true" android:drawable="@drawable/shape_chip_activated" />
    <item android:drawable="@drawable/shape_chip_normal" />
</selector>
