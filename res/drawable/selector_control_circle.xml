<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:gravity="center" android:height="30.0dp" android:width="30.0dp">
                <shape android:shape="oval">
                    <gradient android:startColor="@color/red" android:endColor="@color/red_500" android:angle="315.0" android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true" android:drawable="@drawable/shape_chip_activated" />
    <item android:drawable="@drawable/shape_chip_normal" />
</selector>
